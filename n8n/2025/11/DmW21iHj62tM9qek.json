    {
      "parameters": {
        "description": "=Retrieves the external information from internet using two complementary searches for comprehensive results and citations.\nOnly use this tool if you can not find the answer by your own or user requested to search for internet latest update. Do not use for casual chat.\nThe input should be the search query in user's language focusing on factual information",
        "language": "python",
        "pythonCode": "# Example: convert the incoming query to uppercase and return it\nimport random\nimport aiohttp\n\nsearch_url = {{ $('Get Data').item.json.search_url }}\nsearch_k1 = {{ $('Get Data').item.json.search_k1 }}\ngem_models = [\n    \"gemini-2.0-flash\",\n    \"gemini-2.0-flash\",\n    \"gemini-2.0-flash\",\n    \"gemini-2.5-flash-preview-04-17\",\n]\nkeys = []\nkeys.append(search_k1)\n\nasync with aiohttp.ClientSession() as session:\n    async with session.post(\n        f\"{search_url}/v1beta/models/{random.choice(gem_models)}:generateContent\",\n        params={\"key\": random.choice(keys)},\n        headers={\n            \"Content-Type\": \"application/json\",\n            \"User-Agent\": \"Apifox/1.0.0 (https://apifox.com)\",\n        },\n        json={\n            \"contents\": [\n                {\n                    \"parts\": [\n                        {\"text\": primary_query + \" with the source links\"}\n                    ]\n                }\n            ],\n            \"tools\": [{\"googleSearch\": {}}],\n        },\n    ) as response:\n        result = await response.json()\n        self.logger.info(f\"Primary Query: {primary_query}\")\n        if \"candidates\" in result and len(result[\"candidates\"]) > 0:\n            text = \"\".join(\n                part[\"text\"]\n                for part in result[\"candidates\"][0][\"content\"][\"parts\"]\n            )\n            results.append(\n                f\"Primary Query: {primary_query}? \\n Primary Answer:{text}\"\n            )\n            self.logger.info(f\"Primary Result: {text}\")\n        if \"groundingMetadata\" in result[\"candidates\"][0]:\n            groundingChunks = result[\"candidates\"][0][\"groundingMetadata\"][\n                \"groundingChunks\"\n            ]\n            citations = await self.__convert_grounding_to_citations__(\n                groundingChunks\n            )\n            results.append(f\"\\n Citations: {citations}\")\n            self.logger.info(f\"Citations: {citations}\")\nreturn query.upper()"
      },
