      {
        "parameters": {
          "language": "python",
          "pythonCode": "import asyncio\nimport aiohttp\nimport ssl\nasync def convert_grounding_to_citations(\n    grounding_chunks: list[dict]\n) -> list[dict]:\n    \n    headers = {\n        \"Content-Type\": \"application/json\",\n        \"User-Agent\": \"Tomi/1.0.1 (https://tomi.dev.lspm.io)\",\n    }\n    \n    async with aiohttp.ClientSession(headers=headers) as session:\n        \n        async def _fetch_url_once(url: str, method: str) -> str:\n            print(f\"fetch {url}\")\n            timeout = aiohttp.ClientTimeout(total=2)\n            try:\n                #print(f\"fetch {url}\")\n                request = session.head if method == \"HEAD\" else session.get\n                async with request(\n                    url, allow_redirects=True, timeout=timeout\n                ) as response:\n                    if response.status == 404:\n                        return \"404\"\n                    return str(response.url)\n            except Exception as e:\n                return None\n\n        async def fetch_final_url(url: str) -> str:\n            #print(f\"fetch {url}\")\n            final_url = await _fetch_url_once(url, \"HEAD\")\n            if not final_url:\n                final_url = await _fetch_url_once(url, \"GET\")\n            return final_url\n\n        async def process_chunk(idx, chunk):\n            web_info = chunk\n            original_url = web_info.get(\"uri\", \"\")\n            title = web_info.get(\"title\", \"Unknown Source\")\n            if not original_url:\n                return None\n            #print(f\"fetch {chunk}\")\n            final_url = await fetch_final_url(original_url)\n            \n            if final_url:\n                return {\n                    \"index\": idx,\n                    \"source_url\": final_url,\n                    \"title\": title,\n                }\n            return {\n              \"index\": idx,\n              \"source_url\": title\n            }\n\n        tasks = [\n            process_chunk(idx, chunk) \n            for idx, chunk in enumerate(grounding_chunks)\n        ]\n        \n        results = await asyncio.gather(*tasks)\n        #print(f\"result : {results}\")\n    return [res for res in results]\n\ninput_data = []\nfor item in _input.all():\n  data = {\n    \"uri\" : item.json.web.uri,\n    \"title\": item.json.web.title\n  }\n  input_data.append(data)\noutput = await convert_grounding_to_citations(input_data)\nreturn {\n  \"output\": output\n}\n"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          304,
          0
        ],
        "id": "ff3fdcf0-74f1-424e-ba5d-c553c8c2d43c",
        "name": "fetch_uri_py",
        "alwaysOutputData": false
      },
      {
        "parameters": {
          "jsCode": "const axios = require('axios');\n\nasync function convertGroundingToCitations(groundingChunks) {\n  const headers = {\n    \"Content-Type\": \"application/json\",\n    \"User-Agent\": \"Tomi/1.0.1 (https://tomi.dev.lspm.io)\",\n  };\n\n  async function fetchUrlOnce(url, method) {\n    try {\n      //console.log(`fetch ${url}`);\n      const response = await axios({\n        method: method,\n        url: url,\n        headers: headers,\n        timeout: 2000,\n      });\n\n      if (response.status === 404) {\n        return null;\n      }\n      return response.request.res.responseUrl;\n    } catch (error) {\n      return null;\n    }\n  }\n\n  async function fetchFinalUrl(url) {\n    let finalUrl = await fetchUrlOnce(url, 'HEAD');\n    if (!finalUrl) {\n      finalUrl = await fetchUrlOnce(url, 'GET');\n    }\n    return finalUrl;\n  }\n\n  async function processChunk(idx, chunk) {\n    const webInfo = chunk.json.web;\n    const originalUrl = webInfo.uri || '';\n    const title = webInfo.title || 'Unknown Source';\n\n    if (!originalUrl) {\n      return null;\n    }\n\n    const finalUrl = await fetchFinalUrl(originalUrl);\n\n    if (finalUrl) {\n      return {\n        citation_index: idx,\n        citation_url: finalUrl,\n        citation_title: title,\n      };\n    }\n\n    return {\n      citation_index: idx,\n      citation_url: title,\n    };\n  }\n\n  const tasks = groundingChunks.map((chunk, idx) => processChunk(idx, chunk));\n  const results = await Promise.all(tasks);\n  //console.log(\"result: \" + JSON.stringify(results));\n  return results.filter((res) => res);\n}\n\nconst final = await convertGroundingToCitations($input.all())\nreturn {\n  output : final\n};\n"
        },
